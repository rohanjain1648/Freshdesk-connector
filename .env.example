# Copy to .env (never commit it) or export in your shell.

# --- Freshdesk credentials (or run `freshdesk-connector auth login`) ---
# Subdomain only, e.g. "acme" for https://acme.freshdesk.com
FRESHDESK_DOMAIN=
# Profile settings → "View API key" in Freshdesk
FRESHDESK_API_KEY=

# --- Mode ---
# 1 = use the built-in synthetic Freshdesk (no credentials needed)
FRESHDESK_MOCK=0

# --- Behaviour ---
# Mask requester emails / phone numbers in tool output
FRESHDESK_REDACT_PII=1
# Client-side budget (requests/minute). Trial accounts: 50; Growth: 200; Pro: 400; Enterprise: 700.
FRESHDESK_RATE_LIMIT_PER_MINUTE=50
# Longest the connector will wait on a 429 before returning a "rate limited" error to the agent
FRESHDESK_MAX_RETRY_WAIT_SECONDS=20

# Custom ticket fields that hold the merchant's order id / Razorpay payment id
FRESHDESK_ORDER_ID_FIELD=cf_order_id
FRESHDESK_PAYMENT_ID_FIELD=cf_payment_id

# --- HTTP transport only ---
# Bearer token that Agent Studio must send (Authorization: Bearer <token>)
CONNECTOR_AUTH_TOKEN=
